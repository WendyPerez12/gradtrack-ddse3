// GradTrack — Sistema de Seguimiento de Trabajos de Grado
// Modelo de datos. Ver docs/DATABASE.md para el diagrama y las decisiones de diseño.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rol de la cuenta. La condición de codirector no se modela aquí: depende de
/// la relación del docente con cada trabajo (ver ThesisSupervision).
enum UserRole {
  ADMIN
  COORDINADOR
  DIRECTOR
  CODIRECTOR
  ESTUDIANTE
}

enum ProgramLevel {
  UNDERGRADUATE
  SPECIALIZATION
  MASTER
  DOCTORATE
}

enum PeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum ThesisStatus {
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum SupervisionType {
  DIRECTOR
  CODIRECTOR
}

enum AdvisoryMode {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum AdvisoryStatus {
  SCHEDULED
  COMPLETED
  NOT_COMPLETED
  CANCELLED
  RESCHEDULED
}

enum NotCompletedReason {
  STUDENT_ABSENT
  DIRECTOR_ABSENT
  CANCELLED_BY_AGREEMENT
  TECHNICAL_ISSUE
  OTHER
}

enum MeetingRole {
  STUDENT
  DIRECTOR
  CODIRECTOR
  OTHER
}

enum CommitmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AlertType {
  NO_FIRST_ADVISORY
  INACTIVITY
  MISSED_ADVISORY
  NO_NEXT_ADVISORY
  MINIMUM_ADVISORIES_RISK
  MINIMUM_ADVISORIES_NOT_MET
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum AuditAction {
  LOGIN
  THESIS_CREATED
  THESIS_UPDATED
  DIRECTOR_ASSIGNED
  DIRECTOR_CHANGED
  CODIRECTOR_ASSIGNED
  CODIRECTOR_REMOVED
  ADVISORY_CREATED
  ADVISORY_UPDATED
  ADVISORY_COMPLETED
  ADVISORY_NOT_COMPLETED
  ADVISORY_CANCELLED
  COMMITMENT_CREATED
  COMMITMENT_COMPLETED
  SETTINGS_CHANGED
  ALERT_RESOLVED
  ALERT_DISMISSED
  ALERT_MANAGED
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
}

enum NotificationType {
  ADVISORY_SCHEDULED
  ADVISORY_RESCHEDULED
  ADVISORY_COMPLETED
  COMMITMENT_CREATED
  ALERT_RAISED
  SUPERVISION_ASSIGNED
}

// ---------------------------------------------------------------------------
// Usuarios y programas
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  /// Contraseña temporal fijada por administración: el sistema obliga a
  /// cambiarla en el siguiente ingreso.
  mustChangePassword Boolean   @default(false)
  passwordUpdatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile      StudentProfile?
  memberships         ProgramMembership[]
  supervisions        ThesisSupervision[]  @relation("SupervisionUser")
  supervisionsGranted ThesisSupervision[]  @relation("SupervisionAssignedBy")
  advisoriesCreated   Advisory[]           @relation("AdvisoryCreatedBy")
  advisoriesConfirmed Advisory[]           @relation("AdvisoryConfirmedBy")
  attendances         AdvisoryAttendance[]
  commitments         AdvisoryCommitment[] @relation("CommitmentResponsible")
  alertsResolved      Alert[]              @relation("AlertResolvedBy")
  alertsManaged       Alert[]              @relation("AlertManagedBy")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([role, active])
  @@map("users")
}

model Program {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  level     ProgramLevel
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships     ProgramMembership[]
  periods         AcademicPeriod[]
  cohorts         Cohort[]
  studentProfiles StudentProfile[]
  theses          Thesis[]
  settings        ProgramSettings?

  @@index([active])
  @@map("programs")
}

/// Vincula coordinadores y docentes con los programas que administran o
/// atienden. Un coordinador puede estar en varios programas.
model ProgramMembership {
  id        String   @id @default(cuid())
  userId    String
  programId String
  role      UserRole
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId])
  @@index([userId])
  @@map("program_memberships")
}

model AcademicPeriod {
  id               String       @id @default(cuid())
  programId        String
  name             String
  startDate        DateTime     @db.Date
  endDate          DateTime     @db.Date
  /// Fecha límite institucional para cumplir el mínimo de asesorías del periodo.
  advisoryDeadline DateTime?    @db.Date
  active           Boolean      @default(false)
  status           PeriodStatus @default(PLANNED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  advisories Advisory[]

  @@unique([programId, name])
  @@index([programId, status])
  @@index([active])
  @@map("academic_periods")
}

model Cohort {
  id          String   @id @default(cuid())
  programId   String
  name        String
  startYear   Int
  startPeriod Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  program  Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  students StudentProfile[]

  @@unique([programId, name])
  @@index([programId])
  @@map("cohorts")
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  programId       String
  cohortId        String?
  studentCode     String   @unique
  currentSemester Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id])
  cohort  Cohort? @relation(fields: [cohortId], references: [id])
  theses  Thesis[]

  @@index([programId, active])
  @@index([cohortId])
  @@map("student_profiles")
}

// ---------------------------------------------------------------------------
// Trabajos de grado y supervisión
// ---------------------------------------------------------------------------

model Thesis {
  id          String       @id @default(cuid())
  studentId   String
  programId   String
  title       String
  description String?
  assignedAt  DateTime?
  status      ThesisStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  student      StudentProfile      @relation(fields: [studentId], references: [id])
  program      Program             @relation(fields: [programId], references: [id])
  supervisions ThesisSupervision[]
  advisories   Advisory[]
  alerts       Alert[]

  @@index([programId, status])
  @@index([studentId])
  @@map("theses")
}

/// Histórico de asignaciones. Nunca se sobrescribe: al cambiar de director se
/// cierra la asignación anterior (endedAt + active=false) y se crea una nueva.
model ThesisSupervision {
  id           String          @id @default(cuid())
  thesisId     String
  userId       String
  type         SupervisionType
  startedAt    DateTime        @default(now())
  endedAt      DateTime?
  active       Boolean         @default(true)
  assignedById String?
  createdAt    DateTime        @default(now())

  thesis     Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  user       User   @relation("SupervisionUser", fields: [userId], references: [id])
  assignedBy User?  @relation("SupervisionAssignedBy", fields: [assignedById], references: [id])

  @@index([thesisId, active])
  @@index([userId, active])
  @@index([type, active])
  @@map("thesis_supervisions")
}

// ---------------------------------------------------------------------------
// Asesorías
// ---------------------------------------------------------------------------

model Advisory {
  id                 String              @id @default(cuid())
  thesisId           String
  periodId           String
  scheduledDate      DateTime            @db.Date
  scheduledTime      String?
  actualDate         DateTime?           @db.Date
  mode               AdvisoryMode        @default(IN_PERSON)
  status             AdvisoryStatus      @default(SCHEDULED)
  topic              String
  summary            String?
  observations       String?
  notCompletedReason NotCompletedReason?
  nextAdvisoryDate   DateTime?           @db.Date
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  thesis      Thesis               @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  period      AcademicPeriod       @relation(fields: [periodId], references: [id])
  createdBy   User                 @relation("AdvisoryCreatedBy", fields: [createdById], references: [id])
  confirmedBy User?                @relation("AdvisoryConfirmedBy", fields: [confirmedById], references: [id])
  attendances AdvisoryAttendance[]
  commitments AdvisoryCommitment[]

  @@index([thesisId, status])
  @@index([periodId, status])
  @@index([scheduledDate])
  @@index([status, scheduledDate])
  @@map("advisories")
}

model AdvisoryAttendance {
  id           String      @id @default(cuid())
  advisoryId   String
  userId       String
  roleAtMeeting MeetingRole
  attended     Boolean
  notes        String?
  createdAt    DateTime    @default(now())

  advisory Advisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([advisoryId, userId])
  @@index([advisoryId])
  @@map("advisory_attendances")
}

model AdvisoryCommitment {
  id                String           @id @default(cuid())
  advisoryId        String
  description       String
  responsibleUserId String?
  dueDate           DateTime?        @db.Date
  status            CommitmentStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  completedAt       DateTime?

  advisory    Advisory @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
  responsible User?    @relation("CommitmentResponsible", fields: [responsibleUserId], references: [id])

  @@index([advisoryId])
  @@index([status])
  @@index([responsibleUserId, status])
  @@map("advisory_commitments")
}

// ---------------------------------------------------------------------------
// Alertas, configuración, auditoría y notificaciones
// ---------------------------------------------------------------------------

model Alert {
  id           String        @id @default(cuid())
  thesisId     String
  type         AlertType
  severity     AlertSeverity
  message      String
  detectedAt   DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  status       AlertStatus   @default(ACTIVE)
  metadata     Json?

  /// Gestión humana: la alerta sigue activa porque la condición no ha
  /// cambiado, pero queda constancia de que alguien ya se ocupó de ella.
  managedAt      DateTime?
  managedById    String?
  managementNote String?

  thesis     Thesis @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  managedBy  User?  @relation("AlertManagedBy", fields: [managedById], references: [id])

  @@index([thesisId, status])
  @@index([status, severity])
  @@index([type, status])
  @@map("alerts")
}

/// Parámetros del programa. Ningún umbral vive en el código.
model ProgramSettings {
  id                         String   @id @default(cuid())
  programId                  String   @unique
  minimumAdvisoriesPerPeriod Int      @default(2)
  warningDaysWithoutAdvisory Int      @default(30)
  criticalDaysWithoutAdvisory Int     @default(45)
  /// Días antes del cierre del periodo en que se avisa por mínimo en riesgo.
  riskWindowDaysBeforeDeadline Int    @default(28)
  /// Días de gracia para confirmar o reprogramar una asesoría vencida.
  missedAdvisoryGraceDays    Int      @default(7)
  requireNextAdvisoryDate    Boolean  @default(false)
  alertsEnabled              Boolean  @default(true)
  updatedAt                  DateTime @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_settings")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
